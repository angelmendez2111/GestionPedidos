# Puerto HTTP del Backend
PORT=3000

# Configuración de SQL Server
DB_HOST=localhost
# Si usas puerto fijo o el puerto dinámico actual de SQLEXPRESS (ej. 1433 o 60830).
# Si dejas DB_PORT vacío, TypeORM usará DB_INSTANCE (requiere servicio SQL Browser activo).
DB_PORT=60830
DB_INSTANCE=SQLEXPRESS
DB_USERNAME=sa
DB_PASSWORD=tu_password_aqui
DB_NAME=GestionPedidos

# Opciones TLS para ODBC/Tedious en desarrollo local
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
